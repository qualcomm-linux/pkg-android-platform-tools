#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

## Security Hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -fPIC
export DEB_CPPFLAGS_MAINT_APPEND = -DNDEBUG -UDEBUG
export DEB_CXXFLAGS_MAINT_APPEND = -fPIC
export DEB_LDFLAGS_MAINT_APPEND = -fPIC

## For get-orig-source
export DEB_SOURCE
export DEB_VERSION_UPSTREAM

export DEB_HOST_MULTIARCH

## system/core
export DEB_HOST_MULTIARCH
export DEB_VERSION
# https://android.googlesource.com/platform/development/+/refs/tags/android-10.0.0_r36/sdk/plat_tools_source.prop_template
export PLATFORM_TOOLS_VERSION = 28.0.2

ifneq (, $(shell which clang))
  export CC=clang
  export CXX=clang++
endif

%:
	dh $@ --with bash-completion,javahelper

get-orig-source:
	debian/scripts/get-orig-source

## system/core

s/core/lib%.so: debian/system/core/lib%.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/manpages/system/core/%.1: debian/manpages/system/core/%.1.md
	pandoc --standalone --from=markdown-smart --to=man --output=$@ $<

s/core/libcrypto_utils.so: debian/system/core/libcrypto_utils.mk e/boringssl/libcrypto.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libadb.so: debian/system/core/libadb.mk s/core/libcutils.so s/core/libbase.so s/core/libcrypto_utils.so e/boringssl/libcrypto.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libbacktrace.so: debian/system/core/libbacktrace.mk s/core/libcutils.so s/core/libbase.so s/core/liblog.so e/libunwind/libunwind.so art/libdexfile_support.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libbase.so: debian/system/core/libbase.mk s/core/liblog.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libcutils.so: debian/system/core/libcutils.mk s/core/liblog.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libutils.so: debian/system/core/libutils.mk s/core/liblog.so s/core/libcutils.so s/core/libbacktrace.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/libziparchive.so: debian/system/core/libziparchive.mk s/core/liblog.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/adb: debian/system/core/adb.mk s/core/libadb.so s/core/libcutils.so s/core/libbase.so debian/manpages/system/core/adb.1
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/fastboot: debian/system/core/fastboot.mk s/core/libziparchive.so s/core/libsparse.so s/core/libbase.so s/core/libcutils.so s/core/libadb.so debian/manpages/system/core/fastboot.1 e/boringssl/libcrypto.so s/extras/libext4_utils.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/simg2img: debian/system/core/simg2img.mk s/core/libbase.so s/core/libsparse.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/simg2simg: debian/system/core/simg2simg.mk s/core/libbase.so s/core/libsparse.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/img2simg: debian/system/core/img2simg.mk s/core/libbase.so s/core/libsparse.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/core/append2simg: debian/system/core/append2simg.mk s/core/libbase.so s/core/libsparse.so
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS = \
  s/core/adb \
  s/core/append2simg \
  s/core/fastboot \
  s/core/img2simg \
  s/core/libadb.so \
  s/core/libbacktrace.so \
  s/core/libbase.so \
  s/core/libcrypto_utils.so \
  s/core/libcutils.so \
  s/core/liblog.so \
  s/core/libsparse.so \
  s/core/libutils.so \
  s/core/libziparchive.so \
  s/core/simg2img \
  s/core/simg2simg \

# Whatever depends on BoringSSL must be disabled on MIPS
NON_MIPS_COMPONENTS = s/core/adb s/core/libadb.so s/core/libcrypto_utils.so s/core/fastboot
ifneq ($(filter mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS := $(filter-out $(NON_MIPS_COMPONENTS),$(COMPONENTS))
endif

# Most components only support ARM, x86 and MIPS, but some can be built
# on all architectures.
COMPONENTS_ANY_ARCH = \
  s/core/append2simg \
  s/core/img2simg \
  s/core/libbase.so \
  s/core/libcutils.so \
  s/core/liblog.so \
  s/core/libsparse.so \
  s/core/simg2img \
  s/core/simg2simg \

ifeq ($(filter amd64 i386 armel armhf arm64 mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS := $(filter $(COMPONENTS_ANY_ARCH), $(COMPONENTS))
endif

clean_system_core:
	$(RM) debian/manpages/system/core/*.1
	for component in debian/system/core/*.mk; do \
		make clean --file=$$component; \
	done

## development

debian/manpages/development/%.1: debian/manpages/development/%.1.md
	pandoc --standalone --from=markdown-smart --to=man --output=$@ $<

development/etc1tool: debian/development/etc1tool.mk debian/manpages/development/etc1tool.1 f/native/libETC1.so
	dh_auto_build --buildsystem=makefile -- --file=$<

development/apkcheck: debian/manpages/development/apkcheck.1
	mkdir --parents debian/out/development
	sed 's,^ *libdir=.*,libdir=/usr/share/apkcheck,' development/tools/apkcheck/etc/apkcheck > debian/out/development/apkcheck
	jh_build --no-javadoc --main=com.android.apkcheck.ApkCheck debian/out/development/apkcheck.jar development/tools/apkcheck/src

COMPONENTS += development/etc1tool development/apkcheck

## art

debian/out/art:
	mkdir --parents $@

debian/out/art/%.1: art/%
	help2man -N -n "Dex Tool" --no-discard-stderr --version-string="$(DEB_VERSION)" \
		-o $@ debian/out/$<

art/dmtracedump: debian/art/dmtracedump.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libdexfile_support.so: debian/art/libdexfile_support.mk debian/out/art
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libsigchain.so: debian/art/libsigchain.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

art/dexlist: debian/art/dexlist.mk art/libart.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

art/dexdump: debian/art/dexdump.mk art/libart.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libdexfile_external.so: debian/art/libdexfile_external.mk art/libart.so
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libart.so: debian/art/libart.mk debian/out/art/asm_defines.h art/libsigchain.so s/core/libbacktrace.so s/core/libziparchive.so art/libnativeloader.so art/libnativebridge.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libnativebridge.so:  debian/art/libnativebridge.mk s/core/liblog.so
	dh_auto_build --buildsystem=makefile -- --file=$<

art/libnativeloader.so: debian/art/libnativeloader.mk art/libnativebridge.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

# Only for debug purpose to build standalone object
debian/out/art/asm_defines.h debian/out/art/operator_out.cc: debian/art/libart.mk debian/out/art
	dh_auto_build --buildsystem=makefile -- --file=$< $@
debian/out/art/mterp.S: debian/art/libart.mk debian/out/art debian/out/art/asm_defines.h
	dh_auto_build --buildsystem=makefile -- --file=$< $@
art/runtime/%.o art/libartbase/%.o art/libdexfile/%.o debian/out/art/%.o: debian/art/libart.mk debian/out/art
	dh_auto_build --buildsystem=makefile -- --file=$< $@

# MIPS is left out because ART only supports MIPSr6 while Debian is by default MIPSr2
ifneq ($(filter amd64 i386 armel armhf arm64,$(DEB_HOST_ARCH)),)
  COMPONENTS += \
  art/dexdump \
  art/dexlist \
  art/dmtracedump \
  art/libdexfile_external.so \
  art/libdexfile_support.so \
  art/libnativebridge.so \
  art/libnativeloader.so \
  debian/out/art \
  debian/out/art/dexdump.1 \
  debian/out/art/dmtracedump.1 \

endif

## frameworks/native

f/native/libETC1.so: debian/frameworks/native/libETC1.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

ifneq ($(filter amd64 i386 armel armhf arm64 mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS += f/native/libETC1.so
endif

## external/boringssl

e/boringssl/libcrypto.so: debian/external/boringssl/libcrypto.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

e/boringssl/libssl.so: debian/external/boringssl/libssl.mk e/boringssl/libcrypto.so
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += e/boringssl/libcrypto.so e/boringssl/libssl.so

## external/libunwind

e/libunwind/libunwind.so: debian/external/libunwind/libunwind.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += e/libunwind/libunwind.so

## external/selinux

e/selinux/libsepol.so: debian/external/selinux/libsepol.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

e/selinux/libselinux.so: debian/external/selinux/libselinux.mk e/selinux/libsepol.so
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += e/selinux/libsepol.so e/selinux/libselinux.so

## system/extras

s/extras/libext4_utils.so: debian/system/extras/libext4_utils.mk e/selinux/libselinux.so s/core/libsparse.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

s/extras/libfec.so: debian/system/extras/libfec.mk e/selinux/libselinux.so s/core/libsparse.so s/core/libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += s/extras/libext4_utils.so s/extras/libfec.so

## libnativehelper

libnativehelper/libnativehelper.so: debian/libnativehelper/libnativehelper.mk s/core/liblog.so
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += libnativehelper/libnativehelper.so

## dalvik
dalvik/hprof-conv: debian/dalvik/hprof-conv.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

COMPONENTS += dalvik/hprof-conv

override_dh_auto_build-arch: $(COMPONENTS)

override_dh_auto_test:
	echo ignore tests using upstream build system

override_dh_auto_install:
	echo ignore upstream build system install procedure

override_dh_auto_clean: clean_system_core
	dh_auto_clean
	make clean --file=debian/art/libart.mk

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/lib/$(DEB_HOST_MULTIARCH)/android
