#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

## Security Hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -fPIC
export DEB_CPPFLAGS_MAINT_APPEND = -DNDEBUG -UDEBUG
export DEB_CXXFLAGS_MAINT_APPEND = -fPIC
export DEB_LDFLAGS_MAINT_APPEND = -fPIC

## For get-orig-source
export DEB_SOURCE
export DEB_VERSION_UPSTREAM

# external/jsilver
ANDROID_VERSION = $(shell echo $(DEB_VERSION_UPSTREAM) | sed --expression="s/\+r.*//")
UPSTREAM_TAG = android-$(subst +,_,$(DEB_VERSION_UPSTREAM))

export DEB_HOST_MULTIARCH
export CLASSPATH = /usr/share/java/bcprov.jar:/usr/share/java/bcpkix.jar:/usr/share/java/apksig.jar

## frameworks/base
# https://android.googlesource.com/platform/development/+/android-10.0.0_r36/sdk/build_tools_source.prop_template
export ANDROID_BUILD_TOOLS_VERSION = 29.0.3

## system/core
export DEB_HOST_MULTIARCH
export DEB_VERSION
# https://android.googlesource.com/platform/development/+/refs/tags/android-10.0.0_r36/sdk/plat_tools_source.prop_template
export PLATFORM_TOOLS_VERSION = 28.0.2

ifneq (, $(shell which clang))
  export CC=clang
  export CXX=clang++
endif

COMPONENTS = \
		libbacktrace.so \
		libbase.so \
		libcutils.so \
		liblog.so \
		libsparse.so \
		libutils.so \
		libziparchive.so \
		libcrypto_utils.so \
		simg2img \
		img2simg \
		append2simg \
		simg2simg

COMPONENTS += adb/adb libadb.so fastboot/fastboot libnativebridge.so libnativeloader.so

# Whatever depends on BoringSSL must be disabled on MIPS
NON_MIPS_COMPONENTS = adb/adb libadb.so libcrypto_utils.so fastboot/fastboot
ifneq ($(filter mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS := $(filter-out $(NON_MIPS_COMPONENTS),$(COMPONENTS))
endif

# Most components only support ARM, x86 and MIPS, but some can be built
# on all architectures.
COMPONENTS_ANY_ARCH = \
  append2simg \
  img2simg \
  libbase.so \
  libcutils.so \
  liblog.so \
  libsparse.so \
  simg2img \
  simg2simg
ifeq ($(filter amd64 i386 armel armhf arm64 mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS := $(filter $(COMPONENTS_ANY_ARCH), $(COMPONENTS))
endif

## art

# MIPS is left out because ART only supports MIPSr6 while Debian is by default MIPSr2
ifneq ($(filter amd64 i386 armel armhf arm64,$(DEB_HOST_ARCH)),)
  COMPONENTS += debian/out/art/dexdump debian/out/art/dexlist
  COMPONENTS += debian/out/art/libdexfile_external.so debian/out/art/libdexfile_support.so
endif

## frameworks/native

ifneq ($(filter amd64 i386 armel armhf arm64 mips mipsel mips64el,$(DEB_HOST_ARCH)),)
  COMPONENTS += libETC1.so
endif

%:
	dh $@ --with maven_repo_helper,bash-completion

get-orig-source:
	debian/scripts/get-orig-source

## system/core

lib%.so: debian/system/core/lib%.mk
	dh_auto_build --buildsystem=makefile -- -f $<

debian/manpages/system/core/%.1: debian/manpages/system/core/%.1.md
	pandoc --standalone --from=markdown-smart --to=man --output=$@ $<

libadb.so: debian/system/core/libadb.mk libcutils.so libbase.so libcrypto_utils.so
	dh_auto_build --buildsystem=makefile -- -f $<

libbacktrace.so: debian/system/core/libbacktrace.mk libcutils.so libbase.so liblog.so
	dh_auto_build --buildsystem=makefile -- -f $<

libbase.so: debian/system/core/libbase.mk liblog.so
	dh_auto_build --buildsystem=makefile -- -f $<

libcutils.so: debian/system/core/libcutils.mk liblog.so libbase.so
	dh_auto_build --buildsystem=makefile -- -f $<

libutils.so: debian/system/core/libutils.mk liblog.so libcutils.so libbacktrace.so
	dh_auto_build --buildsystem=makefile -- -f $<

libziparchive: debian/system/core/libziparchive.mk liblog.so libbase.so
	dh_auto_build --buildsystem=makefile -- -f $<

adb/adb: debian/system/core/adb.mk libadb.so libcutils.so libbase.so debian/manpages/system/core/adb.1
	dh_auto_build --buildsystem=makefile -- -f $<

fastboot/fastboot: debian/system/core/fastboot.mk libziparchive.so libsparse.so libbase.so libcutils.so libadb.so debian/manpages/system/core/fastboot.1
	dh_auto_build --buildsystem=makefile -- -f $<

simg2img: debian/system/core/simg2img.mk libbase.so libsparse.so
	dh_auto_build --buildsystem=makefile -- -f $<

simg2simg: debian/system/core/simg2simg.mk libbase.so libsparse.so
	dh_auto_build --buildsystem=makefile -- -f $<

img2simg: debian/system/core/img2simg.mk libbase.so libsparse.so
	dh_auto_build --buildsystem=makefile -- -f $<

append2simg: debian/system/core/append2simg.mk libbase.so libsparse.so
	dh_auto_build --buildsystem=makefile -- -f $<

libnativebridge.so: debian/system/core/libnativebridge.mk liblog.so
	dh_auto_build --buildsystem=makefile -- --file=$<

libnativeloader.so: debian/system/core/libnativeloader.mk libnativebridge.so libbase.so
	dh_auto_build --buildsystem=makefile -- --file=$<

clean_system_core:
	for component in debian/system/core/*.mk; do \
		make clean --file=$$component; \
	done

## development

debian/manpages/development/%.1: debian/manpages/development/%.1.md
	pandoc --standalone --from=markdown-smart --to=man --output=$@ $<

etc1tool: debian/development/etc1tool.mk debian/manpages/development/etc1tool.1
	dh_auto_build --buildsystem=makefile -- -f $<

apkcheck: debian/manpages/development/apkcheck.1
	mkdir --parents debian/out/development
	sed 's,^ *libdir=.*,libdir=/usr/share/apkcheck,' development/tools/apkcheck/etc/apkcheck > debian/out/development/apkcheck
	jh_build --no-javadoc --main=com.android.apkcheck.ApkCheck debian/out/development/apkcheck.jar development/tools/apkcheck/src

COMPONENTS += etc1tool apkcheck

## art

debian/out/art:
	mkdir --parents $@

debian/out/art/%.1: debian/out/art/%
	help2man -N -n "Dex Tool" --no-discard-stderr --version-string="$(DEB_VERSION)" \
		-o $@ $<

debian/out/art/dmtracedump: debian/art/dmtracedump.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/libdexfile_support.so: debian/art/libdexfile_support.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/libsigchain.so: debian/art/libsigchain.mk
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/dexlist: debian/art/dexlist.mk debian/out/art/libart.so
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/dexdump: debian/art/dexdump.mk debian/out/art/libart.so
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/libdexfile_external.so: debian/art/libdexfile_external.mk debian/out/art/libart.so
	dh_auto_build --buildsystem=makefile -- --file=$<

debian/out/art/libart.so: debian/art/libart.mk debian/out/art/asm_defines.h debian/out/art/libsigchain.so
	dh_auto_build --buildsystem=makefile -- --file=$<

# Only for debug purpose to build standalone object
debian/out/art/asm_defines.h debian/out/art/operator_out.cc: debian/art/libart.mk debian/out/art
	dh_auto_build --buildsystem=makefile -- --file=$< $@
debian/out/art/mterp.S: debian/art/libart.mk debian/out/art debian/out/art/asm_defines.h
	dh_auto_build --buildsystem=makefile -- --file=$< $@
art/runtime/%.o art/libartbase/%.o art/libdexfile/%.o debian/out/art/%.o: debian/art/libart.mk debian/out/art
	dh_auto_build --buildsystem=makefile -- --file=$< $@

COMPONENTS += debian/out/art debian/out/art/dmtracedump debian/out/art/dmtracedump.1 debian/out/art/dexdump.1

## frameworks/native

libETC1.so: debian/frameworks/native/libETC1.mk
	dh_auto_build --buildsystem=makefile -- -f $<

## frameworks/base

debian/out/frameworks/base:
	mkdir --parents $@

aapt: debian/frameworks/base/aapt.mk libaapt.so debian/out/frameworks/base
	dh_auto_build --buildsystem=makefile -- -f $<

aapt2: debian/frameworks/base/aapt2.mk libandroidfw.so debian/out/frameworks/base
	dh_auto_build --buildsystem=makefile -- -f $<

aapt2_build-indep: aapt2 debian/out/frameworks/base
	cp /usr/lib/$(DEB_HOST_MULTIARCH)/android/*.so.0 debian/out/frameworks/base
	ln -s /usr/lib/p7zip/7z.so debian/out/frameworks/base/7z.so
	chrpath --replace debian/out/frameworks/base debian/out/frameworks/base/aapt2
	debian/out/frameworks/base/aapt2 compile --dir frameworks/base/core/res/res \
				-o debian/out/frameworks/base/resources.zip
	debian/out/frameworks/base/aapt2 link --manifest frameworks/base/core/res/AndroidManifest.xml \
				debian/out/frameworks/base/resources.zip \
				-o debian/out/frameworks/base/framework-res.apk \
				-A frameworks/base/core/res/assets \
				--min-sdk-version 29 --target-sdk-version 29 \
				--product default \
				--version-code 29 --version-name 10.0.0
	chrpath --replace /usr/lib/$(DEB_HOST_MULTIARCH)/android debian/out/frameworks/base/aapt2

libaapt.so: debian/frameworks/base/libaapt.mk libandroidfw.so debian/out/frameworks/base
	dh_auto_build --buildsystem=makefile -- -f $<

libandroidfw.so: debian/frameworks/base/libandroidfw.mk debian/out/frameworks/base
	dh_auto_build --buildsystem=makefile -- -f $<

debian/manpages/frameworks/base/split-select.1: debian/manpages/frameworks/base/split-select.1.md
	pandoc --standalone --output=$@ $<

split-select: debian/frameworks/base/split-select.mk libandroidfw.so libaapt.so debian/out/frameworks/base debian/manpages/frameworks/base/split-select.1
	dh_auto_build --buildsystem=makefile -- -f $<

COMPONENTS += aapt aapt2 split-select aapt2_build-indep

override_dh_auto_build-arch: $(COMPONENTS)
## external/*
	dh_auto_build --buildsystem=makefile -- -f debian/external/boringssl/libcrypto.mk
	dh_auto_build --buildsystem=makefile -- -f debian/external/boringssl/libssl.mk
	dh_auto_build --buildsystem=makefile -- -f debian/external/selinux/libsepol.mk
	dh_auto_build --buildsystem=makefile -- -f debian/external/selinux/libselinux.mk
	dh_auto_build --buildsystem=makefile -- -f debian/external/libunwind/libunwind.mk
	dh_auto_build --buildsystem=gradle -- assemble --project-dir external/jsilver --project-prop androidVersion=$(ANDROID_VERSION)
## libnativehelper
	dh_auto_build --buildsystem=makefile -- -f debian/libnativehelper/libnativehelper.mk
	dh_auto_build --buildsystem=makefile -- -f debian/system/extras/libext4_utils.mk
	dh_auto_build --buildsystem=makefile -- -f debian/system/extras/libfec.mk

## dalvik
	dh_auto_build --buildsystem=makefile -- -f debian/dalvik/hprof-conv.mk

override_dh_auto_test:
	echo ignore tests using upstream build system

override_dh_auto_install:
	echo ignore upstream build system install procedure

override_dh_auto_clean: clean_system_core
	dh_auto_clean
	$(RM) debian/manpages/system/core/*.1 system/core/adb/adb system/core/fastboot/fastboot
	make clean --file=debian/art/libart.mk

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/lib/$(DEB_HOST_MULTIARCH)/android
